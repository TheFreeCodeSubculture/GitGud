 packages/native/src/markdown/render.rs       | 22 +++++++++++++++++---
 packages/native/src/text/runs.rs             |  2 ++
 packages/native/src/theme.rs                 | 17 +++++++++++++++
 4 files changed, 39 insertions(+), 3 deletions(-)

diff --git a/packages/native/src/custom_elements/input.rs b/packages/native/src/custom_elements/input.rs

+fn parse_resize_edge(name: &str) -> Option<gpui::ResizeEdge> {
+    use gpui::ResizeEdge::*;
+    Some(match name {
+        "top" => Top,
+        "bottom" => Bottom,
+        "left" => Left,
+        "right" => Right,
+        "top-left" => TopLeft,
+        "top-right" => TopRight,
+        "bottom-left" => BottomLeft,
+        "bottom-right" => BottomRight,
+        _ => return None,
+    })
+}
+
+/// Resize borders for a window that draws its own frame, like Zed's
+/// `client_side_decorations`: a thin hit zone around the edge sets the resize
+/// cursor and, in the capture phase, turns a left press into a compositor
+/// resize before any element sees it.
+fn client_resize_handles() -> impl gpui::IntoElement {
+    use gpui::{px, CursorStyle, ResizeEdge, Styled};
+    use std::sync::atomic::{AtomicBool, Ordering};
+    // Zone width in px. Wider than 1 so the border is easy to grab.
+    let zone = px(5.0);
+    // Whether the pointer was on a border at the last move, so leaving it
+    // repaints once and the resize cursor clears.
+    static ON_EDGE: AtomicBool = AtomicBool::new(false);
+    fn edge_at(
+        pos: gpui::Point<gpui::Pixels>,
+        zone: gpui::Pixels,
+        size: gpui::Size<gpui::Pixels>,
+    ) -> Option<ResizeEdge> {
+        let (l, r) = (pos.x < zone, pos.x > size.width - zone);
+        let (t, b) = (pos.y < zone, pos.y > size.height - zone);
+        Some(match (t, b, l, r) {
+            (true, _, true, _) => ResizeEdge::TopLeft,
+            (true, _, _, true) => ResizeEdge::TopRight,
+            (_, true, true, _) => ResizeEdge::BottomLeft,
+            (_, true, _, true) => ResizeEdge::BottomRight,
+            (true, ..) => ResizeEdge::Top,
+            (_, true, ..) => ResizeEdge::Bottom,
+            (_, _, true, _) => ResizeEdge::Left,
+            (_, _, _, true) => ResizeEdge::Right,
+            _ => return None,
+        })
+    }
+    gpui::canvas(
+        |_bounds, window, _cx| {
+            window.insert_hitbox(
+                gpui::Bounds::new(gpui::point(px(0.0), px(0.0)), window.viewport_size()),
+                gpui::HitboxBehavior::Normal,
+            )
+        },
+        move |_bounds, hitbox, window, _cx| {
+            // Maximized and fullscreen windows have nothing to drag out of.
+            if window.is_maximized() || window.is_fullscreen() {
+                return;
+            }
+            let size = window.viewport_size();
+            if let Some(edge) = edge_at(window.mouse_position(), zone, size) {
+                window.set_cursor_style(
+                    match edge {
+                        ResizeEdge::Top | ResizeEdge::Bottom => CursorStyle::ResizeUpDown,
+                        ResizeEdge::Left | ResizeEdge::Right => CursorStyle::ResizeLeftRight,
+                        ResizeEdge::TopLeft | ResizeEdge::BottomRight => {
+                            CursorStyle::ResizeUpLeftDownRight
+                        }
+                        ResizeEdge::TopRight | ResizeEdge::BottomLeft => {
+                            CursorStyle::ResizeUpRightDownLeft
+                        }
+                    },
+                    &hitbox,
+                );
+            }
+            window.on_mouse_event(move |event: &gpui::MouseMoveEvent, phase, window, _cx| {
+                if phase != gpui::DispatchPhase::Bubble {
+                    return;
+                }
+                let on_edge = edge_at(event.position, zone, window.viewport_size()).is_some();
+                if ON_EDGE.swap(on_edge, Ordering::Relaxed) || on_edge {
+                    window.refresh();
+                }
+            });
+            window.on_mouse_event(move |event: &gpui::MouseDownEvent, phase, window, cx| {
+                if phase != gpui::DispatchPhase::Capture
+                    || event.button != gpui::MouseButton::Left
+                    || window.is_maximized()
+                    || window.is_fullscreen()
+                {
+                    return;
+                }
+                if let Some(edge) = edge_at(event.position, zone, window.viewport_size()) {
+                    window.start_window_resize(edge);
+                    cx.stop_propagation();
+                }
+            });
+        },
+    )
+    .size_full()
+    .absolute()
+}

         let runs = match self.marked_range.as_ref() {
             Some(marked) if !is_placeholder => vec![
diff --git a/packages/native/src/markdown/render.rs b/packages/native/src/markdown/render.rs
index 8c8c4ed..b735757 100644
--- a/packages/native/src/markdown/render.rs
+++ b/packages/native/src/markdown/render.rs
@@ -79,6 +79,17 @@ pub struct FlatText {
 
 /// Flatten inline runs into shaped-text inputs. Pure given a theme.
 pub fn flatten_runs(runs: &[InlineRun], theme: &Theme, base_weight: FontWeight) -> FlatText {
+    flatten_runs_sized(runs, theme, base_weight, theme.metrics.md_text_size)
+}
+
+/// [`flatten_runs`] for text drawn at `size`, so inline code can be a fraction of it.
+pub fn flatten_runs_sized(
+    runs: &[InlineRun],
+    theme: &Theme,
+    base_weight: FontWeight,
+    size: f32,
+) -> FlatText {
+    let code_scale = theme.metrics.md_inline_code_scale;
     let mut text = String::new();
     let mut out: Vec<TextRun> = Vec::with_capacity(runs.len());
     let mut links: Vec<(Range<usize>, String)> = Vec::new();
@@ -127,15 +138,18 @@ pub fn flatten_runs(runs: &[InlineRun], theme: &Theme, base_weight: FontWeight)
             len: run.text.len(),
             font: f,
             // Inline code reads violet; links stay the monochrome foreground
-            // with an underline, because accent is reserved for actions.
+            // with an underline, because accent is reserved for actions, unless
+            // the theme sets a link colour.
             color: if run.style.code {
                 theme.code_text
+            } else if run.style.link.is_some() {
+                theme.link.unwrap_or(theme.text)
             } else {
                 theme.text
             },
             background_color: None,
             underline: run.style.link.is_some().then_some(UnderlineStyle {
-                color: Some(theme.text_muted),
+                color: Some(theme.link.unwrap_or(theme.text_muted)),
                 thickness: px(1.0),
                 wavy: false,
             }),
@@ -144,6 +158,8 @@ pub fn flatten_runs(runs: &[InlineRun], theme: &Theme, base_weight: FontWeight)
                 color: Some(theme.text_muted),
             }),
             letter_spacing: None,
+            font_size: (run.style.code && code_scale > 0.0 && code_scale != 1.0)
+                .then(|| px(size * code_scale)),
         });
     }
 
@@ -345,7 +361,7 @@ fn text_element(
 ) -> AnyElement {
     use gpui::prelude::*;
 
-    let flat = flatten_runs(runs, &ctx.theme, weight);
+    let flat = flatten_runs_sized(runs, &ctx.theme, weight, size);
     let inner = flat_text_element(&flat, ctx);
     div()
         .w_full()

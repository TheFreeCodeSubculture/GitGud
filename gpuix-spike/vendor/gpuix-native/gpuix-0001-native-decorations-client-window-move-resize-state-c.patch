+    // `windowDragArea`: dragging from here moves the window, like CSS
+    // `-webkit-app-region: drag`; a double click toggles maximize. The move
+    // starts on the first drag motion, not on the press: the compositor takes
+    // over the pointer as soon as it starts, which would swallow the second
+    // click of a double click. Wayland keeps the press serial, so a move
+    // started a moment later is still accepted. `windowNoDrag` claims the
+    // press for a child such as a window button.
+    let custom_flag = |key: &str| {
+        element
+            .custom_props()
+            .get(key)
+            .and_then(|value| value.as_bool())
+            .unwrap_or(false)
+    };
+    if custom_flag("windowDragArea") {
+        use std::sync::atomic::{AtomicBool, Ordering};
+        static ARMED: AtomicBool = AtomicBool::new(false);
+        el = el
+            .on_mouse_down(gpui::MouseButton::Left, |event, window, _cx| {
+                if event.click_count == 2 {
+                    ARMED.store(false, Ordering::Relaxed);
+                    log::debug!("windowDragArea: double click, toggling maximize");
+                    window.zoom_window();
+                } else {
+                    ARMED.store(true, Ordering::Relaxed);
+                }
+            })
+            .on_mouse_up(gpui::MouseButton::Left, |_event, _window, _cx| {
+                ARMED.store(false, Ordering::Relaxed);
+            })
+            .on_mouse_move(|event, window, _cx| {
+                if event.pressed_button == Some(gpui::MouseButton::Left)
+                    && ARMED.swap(false, Ordering::Relaxed)
+                {
+                    log::debug!("windowDragArea: start_window_move");
+                    window.start_window_move();
+                }
+            });
+    }
+    if custom_flag("windowNoDrag") {
+        el = el.on_mouse_down(gpui::MouseButton::Left, |_event, _window, cx| {
+            cx.stop_propagation();
+        });
+    }
